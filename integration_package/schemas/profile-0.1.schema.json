{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbitfabric:integration:openobsw-opensvf:profile-schema:0.1-candidate",
  "title": "OrbitFabric OpenOBSW/OpenSVF Projection Profile",
  "description": "Integration-specific full-document schema for the OpenOBSW/OpenSVF reference integration Projection Profile 0.1-candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "profile_version",
    "profile",
    "integration",
    "settings",
    "bindings"
  ],
  "properties": {
    "kind": {
      "const": "orbitfabric.projection_profile"
    },
    "profile_version": {
      "const": "0.1-candidate"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema_version"
      ],
      "properties": {
        "id": {
          "const": "orbitfabric-openobsw-opensvf"
        },
        "schema_version": {
          "const": "0.1-candidate"
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatibility",
        "flight_contract",
        "pus",
        "obsw_srdb"
      ],
      "properties": {
        "compatibility": {
          "$ref": "#/$defs/compatibility_settings"
        },
        "flight_contract": {
          "$ref": "#/$defs/flight_contract_settings"
        },
        "pus": {
          "$ref": "#/$defs/pus_settings"
        },
        "obsw_srdb": {
          "$ref": "#/$defs/obsw_srdb_settings"
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "id"
      ],
      "properties": {
        "domain": {
          "enum": [
            "telemetry",
            "commands",
            "events",
            "packets"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "telemetry_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "id"
      ],
      "properties": {
        "domain": {
          "const": "telemetry"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "id16": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "apid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2046
    },
    "compatibility_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_baseline"
      ],
      "properties": {
        "target_baseline": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "flight_contract_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "c_prefix"
      ],
      "properties": {
        "c_prefix": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      }
    },
    "pus_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tm_apid",
        "tc_apid"
      ],
      "properties": {
        "tm_apid": {
          "$ref": "#/$defs/apid"
        },
        "tc_apid": {
          "$ref": "#/$defs/apid"
        }
      }
    },
    "event_severity_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "info",
        "warning",
        "error",
        "critical"
      ],
      "properties": {
        "info": {
          "enum": [
            "INFO",
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "warning": {
          "enum": [
            "INFO",
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "error": {
          "enum": [
            "INFO",
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "critical": {
          "enum": [
            "INFO",
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        }
      }
    },
    "obsw_srdb_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_severity_map"
      ],
      "properties": {
        "event_severity_map": {
          "$ref": "#/$defs/event_severity_map"
        }
      }
    },
    "flight_contract": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "c_symbol": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "command_id": {
          "description": "Independent 16-bit flight-contract ABI allocation. It is not derived from PUS service/subtype; numeric equality with a PUS-derived value is permitted but has no semantic meaning.",
          "$ref": "#/$defs/id16"
        }
      }
    },
    "pus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "subtype"
      ],
      "properties": {
        "apid": {
          "$ref": "#/$defs/apid"
        },
        "service": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "subtype": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "hk_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sid",
        "fields"
      ],
      "properties": {
        "sid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/telemetry_source"
          }
        }
      }
    },
    "obsw_srdb": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "parameter_id": {
          "$ref": "#/$defs/id16"
        },
        "event_id": {
          "$ref": "#/$defs/id16"
        },
        "hk_set": {
          "$ref": "#/$defs/hk_set"
        }
      }
    },
    "expected_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "subtype"
      ],
      "properties": {
        "service": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "subtype": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flight_contract": {
          "$ref": "#/$defs/flight_contract"
        },
        "pus": {
          "$ref": "#/$defs/pus"
        },
        "obsw_srdb": {
          "$ref": "#/$defs/obsw_srdb"
        },
        "expected_responses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/expected_response"
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "intent",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "enum": [
            "project",
            "do_not_project"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "config": {
          "$ref": "#/$defs/config"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "intent": {
                "const": "do_not_project"
              }
            },
            "required": [
              "intent"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "config": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "intent": {
                "const": "project"
              }
            },
            "required": [
              "intent"
            ]
          },
          "then": {
            "required": [
              "config"
            ],
            "properties": {
              "config": {
                "required": [
                  "flight_contract"
                ],
                "properties": {
                  "flight_contract": {
                    "required": [
                      "c_symbol"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "intent": {
                "const": "project"
              },
              "sources": {
                "contains": {
                  "properties": {
                    "domain": {
                      "const": "telemetry"
                    }
                  },
                  "required": [
                    "domain"
                  ]
                }
              }
            },
            "required": [
              "intent",
              "sources"
            ]
          },
          "then": {
            "required": [
              "config"
            ],
            "properties": {
              "config": {
                "required": [
                  "obsw_srdb"
                ],
                "properties": {
                  "obsw_srdb": {
                    "required": [
                      "parameter_id"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "intent": {
                "const": "project"
              },
              "sources": {
                "contains": {
                  "properties": {
                    "domain": {
                      "const": "commands"
                    }
                  },
                  "required": [
                    "domain"
                  ]
                }
              }
            },
            "required": [
              "intent",
              "sources"
            ]
          },
          "then": {
            "required": [
              "config"
            ],
            "properties": {
              "config": {
                "required": [
                  "flight_contract",
                  "pus"
                ],
                "properties": {
                  "flight_contract": {
                    "required": [
                      "command_id"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "intent": {
                "const": "project"
              },
              "sources": {
                "contains": {
                  "properties": {
                    "domain": {
                      "const": "events"
                    }
                  },
                  "required": [
                    "domain"
                  ]
                }
              }
            },
            "required": [
              "intent",
              "sources"
            ]
          },
          "then": {
            "required": [
              "config"
            ],
            "properties": {
              "config": {
                "required": [
                  "obsw_srdb"
                ],
                "properties": {
                  "obsw_srdb": {
                    "required": [
                      "event_id"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "intent": {
                "const": "project"
              },
              "sources": {
                "contains": {
                  "properties": {
                    "domain": {
                      "const": "packets"
                    }
                  },
                  "required": [
                    "domain"
                  ]
                }
              }
            },
            "required": [
              "intent",
              "sources"
            ]
          },
          "then": {
            "required": [
              "config"
            ],
            "properties": {
              "config": {
                "required": [
                  "obsw_srdb"
                ],
                "properties": {
                  "obsw_srdb": {
                    "required": [
                      "hk_set"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "config": {
                "required": [
                  "expected_responses"
                ]
              }
            },
            "required": [
              "config"
            ]
          },
          "then": {
            "properties": {
              "sources": {
                "contains": {
                  "properties": {
                    "domain": {
                      "const": "commands"
                    }
                  },
                  "required": [
                    "domain"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
